{
  "_wave1_note": "Path-based skip filters (test files, node_modules, dist, .next, .turbo, coverage, build, __pycache__) live INSIDE sense-8-smell.js, sense-10-pain.js, sense-15-intuition.js as early-exit checks — NOT as if: filters here. Search for 'Wave 1' in those files. Rationale in memory-vault/sessions/2026-04-15-routines-wave1-shipped.md",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sense-8-smell.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sense-10-pain.js\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sense-15-intuition.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/4d-auto-vision.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
